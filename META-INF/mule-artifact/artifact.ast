u003e\u003c/cron\u003e\r\n\u003c/scheduling-strategy\u003e\r\n\u003c/scheduler\u003e\r\n\u003ctry doc:name\u003d\"Try - Retrieve angle or create a new random one\"\u003e\r\n\u003cset-variable value\u003d\"#[import java!utilities::Calc --- randomInt(360) ]\" doc:name\u003d\"Set angle var\" variableName\u003d\"angle\"\u003e\u003c/set-variable\u003e\r\n\u003cos:store doc:name\u003d\"Store\" key\u003d\"angle\" objectStore\u003d\"Objecstore_coordinates\" failIfPresent\u003d\"true\" failOnNullValue\u003d\"false\"\u003e\r\n\u003cos:value\u003e\u003c![CDATA[\r\n#[vars.angle]\r\n]]\u003e\u003c/os:value\u003e\r\n\u003c/os:store\u003e\r\n\u003ctry doc:name\u003d\"Try\"\u003e\r\n\u003cos:store doc:name\u003d\"Store\" key\u003d\"coordinatesArray\" failIfPresent\u003d\"true\" failOnNullValue\u003d\"false\"\u003e\r\n\u003cos:value\u003e\u003c![CDATA[\r\n#[ [] ]\r\n]]\u003e\u003c/os:value\u003e\r\n\u003c/os:store\u003e\r\n\u003clogger level\u003d\"DEBUG\" doc:name\u003d\"Logger\" message\u003d\"#[\u0027coordinatesArray reset to []  \u0027]\" category\u003d\"com.mulesoft.training.gpswalker\"\u003e\u003c/logger\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"false\" logException\u003d\"false\" doc:name\u003d\"On Error Continue\"\u003e\r\n\u003cos:retrieve doc:name\u003d\"ObjectStore: Get angle\" key\u003d\"initCoordinatesArray\" objectStore\u003d\"Objecstore_coordinates\" target\u003d\"coordinatesArray\"\u003e\r\n\u003cos:default-value\u003e\u003c![CDATA[\r\n#[ [] ]\r\n]]\u003e\u003c/os:default-value\u003e\r\n\u003c/os:retrieve\u003e\r\n\u003clogger level\u003d\"DEBUG\" doc:name\u003d\"Logger\" message\u003d\"#[\u0027coordinatesArray is already in the object store: \u0027 ++ write(vars.coordinatesArray, \u0027application/json\u0027)]\" category\u003d\"com.mulesoft.training.gpswalker\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Logger\" message\u003d\"#[\u0027New direction angle \u0027 ++ vars.angle ++ \u0027 for the Mule app was stored in the object store: \u0027]\" category\u003d\"com.mulesoft.training.gpswalker\"\u003e\u003c/logger\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"false\" logException\u003d\"false\" doc:name\u003d\"On Error Continue\"\u003e\r\n\u003cos:retrieve doc:name\u003d\"ObjectStore: Get angle\" key\u003d\"angle\" target\u003d\"angle\" objectStore\u003d\"Objecstore_coordinates\"\u003e\r\n\u003cos:default-value\u003e\u003c![CDATA[\r\n#[vars.angle]\r\n]]\u003e\u003c/os:default-value\u003e\r\n\u003c/os:retrieve\u003e\r\n\u003clogger level\u003d\"DEBUG\" doc:name\u003d\"Logger\" message\u003d\"#[\u0027Angle \u0027 ++ vars.angle ++ \u0027 already exists in Object Store, so it is not being updated \u0027]\" category\u003d\"com.mulesoft.training.gpswalker\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003cos:retrieve doc:name\u003d\"ObjectStore: Get current coordinate\" key\u003d\"coordinate\" objectStore\u003d\"Objecstore_coordinates\" target\u003d\"currentCoordinates\"\u003e\r\n\u003cos:default-value\u003e\u003c![CDATA[\r\n#[{latitude: p(\u0027gps.defaultLat\u0027) as Number, longitude: p(\u0027gps.defaultLong\u0027) as Number}]\r\n]]\u003e\u003c/os:default-value\u003e\r\n\u003c/os:retrieve\u003e\r\n\u003cset-variable value\u003d\"#[randomInt(360) - 180]\" doc:name\u003d\"Set randAngle var\" variableName\u003d\"randAngle\"\u003e\u003c/set-variable\u003e\r\n\u003cee:transform doc:name\u003d\"Update coordinate with random step\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[\r\n%dw 2.0\n                import java!utilities::Calc\n                import java!java::lang::Math\n\n                output application/java\n\n                var scale \u003d 0.002\n\n                var randStepScale \u003d 0.5\n\n                //var randAngle \u003d randomInt(360) - 180  \n                ---\n                {    \n                    randAngle: vars.randAngle,\n                    latitude: vars.currentCoordinates.latitude  as Number + scale * ( (Math::sin(Math::toRadians(vars.angle)) as Number) + randStepScale * Math::sin(Math::toRadians(vars.randAngle))  ),\n                    longitude: vars.currentCoordinates.longitude as Number + scale * ( Math::cos(Math::toRadians(vars.angle)) + randStepScale * Math::cos(Math::toRadians(vars.randAngle)) )\n                }\r\n]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003ctry doc:name\u003d\"Try\"\u003e\r\n\u003cos:store doc:name\u003d\"ObjectStore: Store new coordinate\" key\u003d\"coordinate\" objectStore\u003d\"Objecstore_coordinates\" failOnNullValue\u003d\"false\"\u003e\u003c/os:store\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"true\" doc:name\u003d\"On Error Continue\"\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Logger\" message\u003d\"Could not store new coordinate in object store\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/flow\u003e","startColumn":5,"startLine":16},"parameters":[{"unresolvedValue":"updateCoordinateFlow","metadata":{"docAttributes":{},"endColumn":12,"endLine":87,"fileName":"gpswalker.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":12},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":16},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":16},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":87},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer",